#!/bin/bash
#PBS -N video_curation
#PBS -l select=1:ngpus=4
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o curation_output.log
#PBS -q ai
#PBS -P 52001004

cd $PBS_O_WORKDIR

echo "Starting job on $(hostname) at $(date)"

CONDA_DIR="$HOME/miniconda3"
source "$CONDA_DIR/etc/profile.d/conda.sh"
conda activate video_curation_env
unset PYTHONPATH
unset PYTHONHOME
export PATH="$HOME/miniconda3/envs/video_curation_env/bin:$PATH"
export LD_LIBRARY_PATH=/usr/lib64:$LD_LIBRARY_PATH

echo "GPUs:    $(nvidia-smi --query-gpu=name,memory.total --format=csv,noheader)"
echo "Python:  $(python --version 2>&1)"
echo "PyTorch: $(python -c 'import torch; print(torch.__version__, "| GPUs:", torch.cuda.device_count())')"

# ── Scratch storage ───────────────────────────────────────────────────────────
# WANDB_API_KEY must be set in the environment before submitting.
# Never hardcode credentials in PBS scripts.
# Set via:  export WANDB_API_KEY=<your_key>  on the login node before qsub.
if [ -z "$WANDB_API_KEY" ]; then
    echo "ERROR: WANDB_API_KEY is not set. Export it on the login node before qsub." >&2
    exit 1
fi
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export HF_HUB_OFFLINE=1
export SCRATCH_DIR="$HOME/scratch/video-curation"
mkdir -p "$SCRATCH_DIR"
echo "Scratch: $SCRATCH_DIR"

# ── Config ────────────────────────────────────────────────────────────────────
VERSION="v2"
LIMIT=10                # number of S3 tar files (~50 clips each → ~500 clips total)
FRAMES=8                # frames sampled per video for CLIP / scoring
NUM_GPUS=4              # GPUs available on this node
MIN_SCORE=4.5           # LAION aesthetic threshold
MIN_MOTION=3.0          # motion quality threshold (v2): optical flow + SSIM composite
MIN_QUALITY=0.3         # caption quality threshold (v2): CLIP text-image alignment composite
DEDUP_THRESH=0.95       # cosine similarity threshold for near-dedup
SHARD_SIZE=200          # samples per WebDataset shard
SOURCE="kinetics400"    # dataset source tag for composition tracking
LATENT_FRAMES=16        # frames per video for VAE latent encoding
LATENT_RES=256          # spatial resolution before VAE 8× downsampling

# ── GPU concurrency summary ───────────────────────────────────────────────────
# embed:          0.25 GPU/task → 16 concurrent tasks  (4 GPUs × 4 tasks/GPU)
# score:          0.25 GPU/task → 16 concurrent tasks
# caption:        1.0  GPU/task →  4 concurrent tasks  (one per GPU, Qwen3-VL-8B)
# motion:         CPU-only      → 16 workers
# caption_quality: 0.5 GPU/task →  8 concurrent tasks
# encode_latents: 0.5 GPU/task →  8 concurrent tasks

# ── Run (v2 — all stages including motion, caption quality, latent encoding) ──
python dag.py \
    --split             val \
    --version           $VERSION \
    --limit             $LIMIT \
    --frames_per_video  $FRAMES \
    --num_gpus          $NUM_GPUS \
    --dedup_threshold   $DEDUP_THRESH \
    --min_score         $MIN_SCORE \
    --min_motion        $MIN_MOTION \
    --min_quality       $MIN_QUALITY \
    --shard_size        $SHARD_SIZE \
    --source            $SOURCE \
    --latent_frames     $LATENT_FRAMES \
    --latent_resolution $LATENT_RES \
    --from_stage        ingest

echo "Job completed at $(date)"
