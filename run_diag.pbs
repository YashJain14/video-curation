#!/bin/bash
#PBS -N video_diag
#PBS -l select=1:ngpus=4
#PBS -l walltime=00:30:00
#PBS -j oe
#PBS -o diag_output.log
#PBS -q ai
#PBS -P 52001004

cd $PBS_O_WORKDIR

echo "============================================================"
echo "DIAGNOSTIC JOB  host=$(hostname)  date=$(date)"
echo "============================================================"

CONDA_DIR="$HOME/miniconda3"
source "$CONDA_DIR/etc/profile.d/conda.sh"
conda activate video_curation_env
unset PYTHONPATH
unset PYTHONHOME
export PATH="$HOME/miniconda3/envs/video_curation_env/bin:$PATH"
export LD_LIBRARY_PATH=/usr/lib64:$LD_LIBRARY_PATH

export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export SCRATCH_DIR="$HOME/scratch/video-curation"

echo ""
echo "--- Environment ---"
echo "Python:       $(python --version 2>&1)"
echo "PyTorch:      $(python -c 'import torch; print(torch.__version__, "| CUDA:", torch.version.cuda, "| GPUs:", torch.cuda.device_count())')"
echo "PyNvVideoCodec: $(python -c 'import PyNvVideoCodec; print(PyNvVideoCodec.__version__)' 2>&1)"
echo "pip pynvvideocodec: $(pip show pynvvideocodec 2>/dev/null | grep Version || echo NOT_INSTALLED)"
echo "GPUs:"
nvidia-smi --query-gpu=index,name,memory.total,driver_version --format=csv,noheader
echo ""

# Pick one real video to use in tests
TEST_VIDEO=$(find "$SCRATCH_DIR/raw_videos" -name "*.mp4" | head -1)
echo "Test video: $TEST_VIDEO"
echo ""

# ── TEST 1: decode.py standalone — single video, GPU decode ──────────────────
echo "============================================================"
echo "TEST 1: decode.py standalone (GPU decode, single process)"
echo "============================================================"
python decode.py --video "$TEST_VIDEO" --max_frames 64 --batch_size 16 --device cuda:0
echo "TEST 1 exit=$?"
echo ""

# ── TEST 2: embed.py — 1 GPU, 4 actors, 50 videos ────────────────────────────
echo "============================================================"
echo "TEST 2: embed.py  num_gpus=1 (4 actors, 1 GPU)"
echo "============================================================"
VIDEOS_50=$(find "$SCRATCH_DIR/raw_videos" -name "*.mp4" | head -50)
TMP_DIR=$(mktemp -d)
# symlink those 50 videos into a flat temp dir so embed.py sees them
for v in $VIDEOS_50; do ln -s "$v" "$TMP_DIR/$(basename $v)" 2>/dev/null; done
echo "Linked $(ls $TMP_DIR | wc -l) videos into $TMP_DIR"

python embed.py \
    --video_dir "$TMP_DIR" \
    --out_dir   "/tmp/diag_embeddings_1gpu" \
    --frames_per_video 8 \
    --num_gpus 1
echo "TEST 2 exit=$?"
echo ""

rm -rf "$TMP_DIR" /tmp/diag_embeddings_1gpu

# ── TEST 3: embed.py — 4 GPUs, 16 actors, 50 videos ─────────────────────────
echo "============================================================"
echo "TEST 3: embed.py  num_gpus=4 (16 actors, 4 GPUs) — same 50 videos"
echo "============================================================"
TMP_DIR2=$(mktemp -d)
for v in $(find "$SCRATCH_DIR/raw_videos" -name "*.mp4" | head -50); do
    ln -s "$v" "$TMP_DIR2/$(basename $v)" 2>/dev/null
done
echo "Linked $(ls $TMP_DIR2 | wc -l) videos into $TMP_DIR2"

python embed.py \
    --video_dir "$TMP_DIR2" \
    --out_dir   "/tmp/diag_embeddings_4gpu" \
    --frames_per_video 8 \
    --num_gpus 4
echo "TEST 3 exit=$?"
echo ""

rm -rf "$TMP_DIR2" /tmp/diag_embeddings_4gpu

echo "============================================================"
echo "DIAGNOSTIC COMPLETE  $(date)"
echo "============================================================"